// SmartHR Lanka - Production MySQL Schema with strict DECIMAL(12, 2) and foreign keys

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String   @id @default(uuid())
  name             String   @db.VarChar(255)
  code             String   @unique @db.VarChar(50)
  taxNumber        String?  @db.VarChar(100)
  email            String?  @db.VarChar(255)
  phone            String?  @db.VarChar(50)
  address          String?  @db.Text
  logo             String?  @db.VarChar(500)
  currency         String   @default("LKR") @db.VarChar(10)
  timezone         String   @default("Asia/Colombo") @db.VarChar(50)
  fiscalYearStart  String   @default("01-01") @db.VarChar(10)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branches                   Branch[]
  departments                Department[]
  designations               Designation[]
  users                      User[]
  roles                      Role[]
  employees                  Employee[]
  workSchedules              WorkSchedule[]
  shifts                     Shift[]
  attendanceRecords          AttendanceRecord[]
  attendanceEvents           AttendanceEvent[]
  attendanceCorrections      AttendanceCorrection[]
  overtimeRequests           OvertimeRequest[]
  leaveTypes                 LeaveType[]
  leavePolicies              LeavePolicy[]
  leaveBalances              LeaveBalance[]
  leaveRequests              LeaveRequest[]
  leaveLedgers               LeaveLedger[]
  salaryStructures           SalaryStructure[]
  salaryComponents           SalaryComponent[]
  employeeSalaryAssignments  EmployeeSalaryAssignment[]
  employeeLoans              EmployeeLoan[]
  statutoryRuleSets          StatutoryRuleSet[]
  payrollPeriods             PayrollPeriod[]
  payrollRuns                PayrollRun[]
  payslips                   Payslip[]
  employeeDocuments          EmployeeDocument[]
  holidays                   Holiday[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  systemSettings             SystemSetting[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  name           String       @db.VarChar(255)
  code           String       @db.VarChar(50)
  address        String?      @db.Text
  phone          String?      @db.VarChar(50)
  isHeadOffice   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments    Department[]
  employees      Employee[]

  @@unique([organizationId, code])
  @@map("branches")
}

model User {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  email          String       @db.VarChar(255)
  passwordHash   String       @db.VarChar(255)
  firstName      String       @db.VarChar(100)
  lastName       String       @db.VarChar(100)
  phone          String?      @db.VarChar(50)
  isActive       Boolean      @default(true)
  avatarUrl      String?      @db.VarChar(500)
  lastLoginAt    DateTime?
  refreshToken   String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee?
  userRoles      UserRole[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String           @id @default(uuid())
  organizationId String           @db.VarChar(36)
  name           String           @db.VarChar(100)
  code           String           @db.VarChar(50)
  description    String?          @db.Text
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles      UserRole[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(100)
  code        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(50)
  description String?          @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @db.VarChar(36)
  permissionId String     @db.VarChar(36)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @db.VarChar(36)
  roleId String @db.VarChar(36)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  branchId       String?      @db.VarChar(36)
  name           String       @db.VarChar(255)
  code           String       @db.VarChar(50)
  description    String?      @db.Text
  managerId      String?      @db.VarChar(36)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  designations   Designation[]
  employees      Employee[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Designation {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  departmentId   String?      @db.VarChar(36)
  title          String       @db.VarChar(255)
  code           String       @db.VarChar(50)
  level          Int          @default(1)
  description    String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees      Employee[]

  @@unique([organizationId, code])
  @@map("designations")
}

model Employee {
  id                       String       @id @default(uuid())
  organizationId           String       @db.VarChar(36)
  branchId                 String?      @db.VarChar(36)
  departmentId             String?      @db.VarChar(36)
  designationId            String?      @db.VarChar(36)
  userId                   String?      @unique @db.VarChar(36)
  employeeId               String       @db.VarChar(50)
  firstName                String       @db.VarChar(100)
  lastName                 String       @db.VarChar(100)
  callingName              String?      @db.VarChar(100)
  nicOrPassport            String?      @db.VarChar(50)
  gender                   String?      @db.VarChar(20)
  dateOfBirth              String?      @db.VarChar(10)
  maritalStatus            String?      @db.VarChar(20)
  workEmail                String       @db.VarChar(255)
  personalEmail            String?      @db.VarChar(255)
  workPhone                String?      @db.VarChar(50)
  personalPhone            String?      @db.VarChar(50)
  address                  String?      @db.Text
  emergencyContactName     String?      @db.VarChar(100)
  emergencyContactPhone    String?      @db.VarChar(50)
  emergencyContactRelation String?      @db.VarChar(50)
  employmentType           String       @default("PERMANENT") @db.VarChar(50)
  employmentStatus         String       @default("ACTIVE") @db.VarChar(50)
  joinDate                 String       @db.VarChar(10)
  confirmationDate         String?      @db.VarChar(10)
  probationEndDate         String?      @db.VarChar(10)
  contractEndDate          String?      @db.VarChar(10)
  resignationDate          String?      @db.VarChar(10)
  bankName                 String?      @db.VarChar(100)
  bankBranch               String?      @db.VarChar(100)
  bankAccountNumber        String?      @db.VarChar(50)
  bankAccountName          String?      @db.VarChar(100)
  epfNumber                String?      @db.VarChar(50)
  tinNumber                String?      @db.VarChar(50)
  reportingManagerId       String?      @db.VarChar(36)
  avatarUrl                String?      @db.VarChar(500)
  deletedAt                DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch                   Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department               Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation              Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  user                     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reportingManager         Employee?    @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id])
  subordinates             Employee[]   @relation("ManagerSubordinates")

  employmentHistories      EmploymentHistory[]
  attendanceRecords        AttendanceRecord[]
  attendanceEvents         AttendanceEvent[]
  attendanceCorrections    AttendanceCorrection[]
  overtimeRequests         OvertimeRequest[]
  leaveBalances            LeaveBalance[]
  leaveRequests            LeaveRequest[]
  leaveLedgers             LeaveLedger[]
  salaryAssignments        EmployeeSalaryAssignment[]
  employeeLoans            EmployeeLoan[]
  payrollRunEmployees      PayrollRunEmployee[]
  payslips                 Payslip[]
  documents                EmployeeDocument[]
  notifications            Notification[]

  @@unique([organizationId, employeeId])
  @@unique([organizationId, workEmail])
  @@map("employees")
}

model EmploymentHistory {
  id            String   @id @default(uuid())
  employeeId    String   @db.VarChar(36)
  eventType     String   @db.VarChar(50)
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  effectiveDate String   @db.VarChar(10)
  remarks       String?  @db.Text
  createdAt     DateTime @default(now())

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employment_history")
}

model WorkSchedule {
  id                  String       @id @default(uuid())
  organizationId      String       @db.VarChar(36)
  name                String       @db.VarChar(100)
  code                String       @db.VarChar(50)
  mondayHours         Decimal      @default(8.0) @db.Decimal(5, 2)
  tuesdayHours        Decimal      @default(8.0) @db.Decimal(5, 2)
  wednesdayHours      Decimal      @default(8.0) @db.Decimal(5, 2)
  thursdayHours       Decimal      @default(8.0) @db.Decimal(5, 2)
  fridayHours         Decimal      @default(8.0) @db.Decimal(5, 2)
  saturdayHours       Decimal      @default(4.0) @db.Decimal(5, 2)
  sundayHours         Decimal      @default(0.0) @db.Decimal(5, 2)
  standardWeeklyHours Decimal      @default(44.0) @db.Decimal(5, 2)
  isDefault           Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@map("work_schedules")
}

model Shift {
  id                   String             @id @default(uuid())
  organizationId       String             @db.VarChar(36)
  name                 String             @db.VarChar(100)
  code                 String             @db.VarChar(50)
  startTime            String             @db.VarChar(10)
  endTime              String             @db.VarChar(10)
  gracePeriodMinutes   Int                @default(15)
  breakDurationMinutes Int                @default(60)
  isOvernight          Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceRecords    AttendanceRecord[]

  @@unique([organizationId, code])
  @@map("shifts")
}

model AttendanceRecord {
  id                     String       @id @default(uuid())
  organizationId         String       @db.VarChar(36)
  employeeId             String       @db.VarChar(36)
  shiftId                String?      @db.VarChar(36)
  date                   String       @db.VarChar(10)
  clockIn                DateTime?
  clockOut               DateTime?
  totalHours             Decimal      @default(0.00) @db.Decimal(6, 2)
  lateMinutes            Int          @default(0)
  earlyDepartureMinutes  Int          @default(0)
  overtimeMinutes        Int          @default(0)
  status                 String       @default("PRESENT") @db.VarChar(30)
  missingClockOut        Boolean      @default(false)
  remarks                String?      @db.Text
  isCorrected            Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee               Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift                  Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  attendanceCorrections  AttendanceCorrection[]

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model AttendanceEvent {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  employeeId     String       @db.VarChar(36)
  eventType      String       @db.VarChar(30)
  timestamp      DateTime     @default(now())
  source         String       @default("WEB") @db.VarChar(30)
  ipAddress      String?      @db.VarChar(50)
  remarks        String?      @db.Text

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("attendance_events")
}

model AttendanceCorrection {
  id                 String           @id @default(uuid())
  organizationId     String           @db.VarChar(36)
  employeeId         String           @db.VarChar(36)
  attendanceRecordId String           @db.VarChar(36)
  originalClockIn    DateTime?
  originalClockOut   DateTime?
  proposedClockIn    DateTime?
  proposedClockOut   DateTime?
  reason             String           @db.Text
  status             String           @default("PENDING") @db.VarChar(30)
  requestedById      String           @db.VarChar(36)
  reviewedById       String?          @db.VarChar(36)
  reviewNotes        String?          @db.Text
  reviewedAt         DateTime?
  createdAt          DateTime         @default(now())

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@map("attendance_corrections")
}

model OvertimeRequest {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  employeeId     String       @db.VarChar(36)
  date           String       @db.VarChar(10)
  hoursRequested Decimal      @db.Decimal(5, 2)
  otType         String       @default("NORMAL_1_5X") @db.VarChar(30)
  reason         String       @db.Text
  status         String       @default("PENDING") @db.VarChar(30)
  reviewedById   String?      @db.VarChar(36)
  reviewNotes    String?      @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("overtime_requests")
}

model LeaveType {
  id                 String         @id @default(uuid())
  organizationId     String         @db.VarChar(36)
  name               String         @db.VarChar(100)
  code               String         @db.VarChar(50)
  defaultDaysPerYear Decimal        @default(14.0) @db.Decimal(5, 2)
  isPaid             Boolean        @default(true)
  allowHalfDay       Boolean        @default(true)
  requiresDocument   Boolean        @default(false)
  carryForwardMax    Decimal        @default(0.0) @db.Decimal(5, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leavePolicies      LeavePolicy[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  leaveLedgers       LeaveLedger[]

  @@unique([organizationId, code])
  @@map("leave_types")
}

model LeavePolicy {
  id                 String       @id @default(uuid())
  organizationId     String       @db.VarChar(36)
  leaveTypeId        String       @db.VarChar(36)
  name               String       @db.VarChar(100)
  description        String?      @db.Text
  minServiceMonths   Int          @default(0)
  proratedFirstYear  Boolean      @default(true)
  accrualFrequency   String       @default("ANNUAL") @db.VarChar(30)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveType          LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@map("leave_policies")
}

model LeaveBalance {
  id                 String       @id @default(uuid())
  organizationId     String       @db.VarChar(36)
  employeeId         String       @db.VarChar(36)
  leaveTypeId        String       @db.VarChar(36)
  year               Int
  allocatedDays      Decimal      @default(0.0) @db.Decimal(5, 2)
  carriedForwardDays Decimal      @default(0.0) @db.Decimal(5, 2)
  usedDays           Decimal      @default(0.0) @db.Decimal(5, 2)
  pendingDays        Decimal      @default(0.0) @db.Decimal(5, 2)
  remainingDays      Decimal      @default(0.0) @db.Decimal(5, 2)
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id             String          @id @default(uuid())
  organizationId String          @db.VarChar(36)
  employeeId     String          @db.VarChar(36)
  leaveTypeId    String          @db.VarChar(36)
  startDate      String          @db.VarChar(10)
  endDate        String          @db.VarChar(10)
  totalDays      Decimal         @db.Decimal(5, 2)
  isHalfDay      Boolean         @default(false)
  halfDayType    String?         @db.VarChar(20)
  reason         String          @db.Text
  attachmentUrl  String?         @db.VarChar(500)
  status         String          @default("PENDING") @db.VarChar(30)
  reviewedById   String?         @db.VarChar(36)
  reviewNotes    String?         @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approvals      LeaveApproval[]

  @@map("leave_requests")
}

model LeaveApproval {
  id             String       @id @default(uuid())
  leaveRequestId String       @db.VarChar(36)
  approverId     String       @db.VarChar(36)
  stepOrder      Int          @default(1)
  decision       String       @db.VarChar(30)
  comments       String?      @db.Text
  actionDate     DateTime     @default(now())

  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@map("leave_approvals")
}

model LeaveLedger {
  id              String       @id @default(uuid())
  organizationId  String       @db.VarChar(36)
  employeeId      String       @db.VarChar(36)
  leaveTypeId     String       @db.VarChar(36)
  transactionType String       @db.VarChar(30)
  days            Decimal      @db.Decimal(5, 2)
  balanceAfter    Decimal      @db.Decimal(5, 2)
  referenceId     String?      @db.VarChar(100)
  remarks         String?      @db.Text
  createdAt       DateTime     @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@map("leave_ledger")
}

model SalaryStructure {
  id             String                     @id @default(uuid())
  organizationId String                     @db.VarChar(36)
  name           String                     @db.VarChar(100)
  code           String                     @db.VarChar(50)
  description    String?                    @db.Text
  effectiveFrom  String                     @db.VarChar(10)
  effectiveTo    String?                    @db.VarChar(10)
  isDefault      Boolean                    @default(false)
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    EmployeeSalaryAssignment[]

  @@unique([organizationId, code])
  @@map("salary_structures")
}

model SalaryComponent {
  id                       String                    @id @default(uuid())
  organizationId           String                    @db.VarChar(36)
  name                     String                    @db.VarChar(100)
  code                     String                    @db.VarChar(50)
  type                     String                    @db.VarChar(30)
  calculationType          String                    @default("FIXED") @db.VarChar(30)
  percentageRate           Decimal                   @default(0.00) @db.Decimal(5, 2)
  isRecurring              Boolean                   @default(true)
  isEpfApplicable          Boolean                   @default(false)
  isEtfApplicable          Boolean                   @default(false)
  isTaxable                Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeSalaryComponents EmployeeSalaryComponent[]

  @@unique([organizationId, code])
  @@map("salary_components")
}

model EmployeeSalaryAssignment {
  id                String                    @id @default(uuid())
  organizationId    String                    @db.VarChar(36)
  employeeId        String                    @db.VarChar(36)
  salaryStructureId String?                   @db.VarChar(36)
  baseSalary        Decimal                   @db.Decimal(12, 2)
  paymentFrequency  String                    @default("MONTHLY") @db.VarChar(30)
  currency          String                    @default("LKR") @db.VarChar(10)
  effectiveFrom     String                    @db.VarChar(10)
  effectiveTo       String?                   @db.VarChar(10)
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee          Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure   SalaryStructure?          @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  components        EmployeeSalaryComponent[]

  @@map("employee_salary_assignments")
}

model EmployeeSalaryComponent {
  id                         String                   @id @default(uuid())
  employeeSalaryAssignmentId String                   @db.VarChar(36)
  salaryComponentId          String                   @db.VarChar(36)
  amount                     Decimal                  @default(0.00) @db.Decimal(12, 2)
  customPercentage           Decimal?                 @db.Decimal(5, 2)
  isActive                   Boolean                  @default(true)

  salaryAssignment           EmployeeSalaryAssignment @relation(fields: [employeeSalaryAssignmentId], references: [id], onDelete: Cascade)
  salaryComponent            SalaryComponent          @relation(fields: [salaryComponentId], references: [id], onDelete: Cascade)

  @@unique([employeeSalaryAssignmentId, salaryComponentId])
  @@map("employee_salary_components")
}

model EmployeeLoan {
  id                    String            @id @default(uuid())
  organizationId        String            @db.VarChar(36)
  employeeId            String            @db.VarChar(36)
  loanType              String            @default("SALARY_ADVANCE") @db.VarChar(50)
  principalAmount       Decimal           @db.Decimal(12, 2)
  interestRate          Decimal           @default(0.00) @db.Decimal(5, 2)
  totalAmount           Decimal           @db.Decimal(12, 2)
  monthlyInstallment    Decimal           @db.Decimal(12, 2)
  totalInstallments     Int               @default(1)
  remainingInstallments Int               @default(1)
  outstandingBalance    Decimal           @db.Decimal(12, 2)
  status                String            @default("ACTIVE") @db.VarChar(30)
  disbursementDate      String?           @db.VarChar(10)
  approvedById          String?           @db.VarChar(36)
  remarks               String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  transactions          LoanTransaction[]

  @@map("employee_loans")
}

model LoanTransaction {
  id                   String              @id @default(uuid())
  loanId               String              @db.VarChar(36)
  payrollRunEmployeeId String?             @db.VarChar(36)
  transactionType      String              @db.VarChar(50)
  amount               Decimal             @db.Decimal(12, 2)
  balanceAfter         Decimal             @db.Decimal(12, 2)
  paymentDate          String              @db.VarChar(10)
  remarks              String?             @db.Text
  createdAt            DateTime            @default(now())

  loan                 EmployeeLoan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payrollRunEmployee   PayrollRunEmployee? @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: SetNull)

  @@map("loan_transactions")
}

model StatutoryRuleSet {
  id                          String       @id @default(uuid())
  organizationId              String       @db.VarChar(36)
  name                        String       @db.VarChar(100)
  effectiveFrom               String       @db.VarChar(10)
  effectiveTo                 String?      @db.VarChar(10)
  epfEmployeeRate             Decimal      @default(8.00) @db.Decimal(5, 2)
  epfEmployerRate             Decimal      @default(12.00) @db.Decimal(5, 2)
  etfEmployerRate             Decimal      @default(3.00) @db.Decimal(5, 2)
  apitTaxFreeAllowanceMonthly Decimal      @default(100000.00) @db.Decimal(12, 2)
  apitTaxSlabsJson            String       @db.Text
  standardMonthlyWorkDays     Int          @default(26)
  standardMonthlyWorkHours    Int          @default(200)
  overtimeNormalRate          Decimal      @default(1.50) @db.Decimal(5, 2)
  overtimeHolidayRate         Decimal      @default(2.00) @db.Decimal(5, 2)
  isVerifiedSriLankan         Boolean      @default(true)
  isDefault                   Boolean      @default(true)
  notes                       String?      @db.Text
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("statutory_rule_sets")
}

model PayrollPeriod {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  name           String       @db.VarChar(100)
  periodCode     String       @db.VarChar(20)
  startDate      String       @db.VarChar(10)
  endDate        String       @db.VarChar(10)
  paymentDate    String       @db.VarChar(10)
  status         String       @default("UPCOMING") @db.VarChar(30)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRuns    PayrollRun[]

  @@unique([organizationId, periodCode])
  @@map("payroll_periods")
}

model PayrollRun {
  id                         String               @id @default(uuid())
  organizationId             String               @db.VarChar(36)
  payrollPeriodId            String               @db.VarChar(36)
  runNumber                  String               @db.VarChar(50)
  status                     String               @default("DRAFT") @db.VarChar(30)
  totalGrossPay              Decimal              @default(0.00) @db.Decimal(14, 2)
  totalNetPay                Decimal              @default(0.00) @db.Decimal(14, 2)
  totalEmployeeDeductions    Decimal              @default(0.00) @db.Decimal(14, 2)
  totalEmployerContributions Decimal              @default(0.00) @db.Decimal(14, 2)
  totalEmployerCost          Decimal              @default(0.00) @db.Decimal(14, 2)
  employeeCount              Int                  @default(0)
  processedById              String?              @db.VarChar(36)
  approvedById               String?              @db.VarChar(36)
  finalizedById              String?              @db.VarChar(36)
  approvedAt                 DateTime?
  finalizedAt                DateTime?
  notes                      String?              @db.Text
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  organization               Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod              PayrollPeriod        @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  payrollRunEmployees        PayrollRunEmployee[]

  @@unique([organizationId, payrollPeriodId, runNumber])
  @@map("payroll_runs")
}

model PayrollRunEmployee {
  id                      String             @id @default(uuid())
  payrollRunId            String             @db.VarChar(36)
  employeeId              String             @db.VarChar(36)
  employeeCode            String             @db.VarChar(50)
  employeeName            String             @db.VarChar(200)
  departmentName          String?            @db.VarChar(100)
  designationName         String?            @db.VarChar(100)
  bankAccountNumber       String?            @db.VarChar(50)
  bankName                String?            @db.VarChar(100)
  basicSalary             Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAllowances         Decimal            @default(0.00) @db.Decimal(12, 2)
  totalBonuses            Decimal            @default(0.00) @db.Decimal(12, 2)
  overtimeEarnings        Decimal            @default(0.00) @db.Decimal(12, 2)
  noPayDeductions         Decimal            @default(0.00) @db.Decimal(12, 2)
  noPayDays               Decimal            @default(0.00) @db.Decimal(5, 2)
  overtimeHoursNormal     Decimal            @default(0.00) @db.Decimal(6, 2)
  overtimeHoursHoliday    Decimal            @default(0.00) @db.Decimal(6, 2)
  grossEarnings           Decimal            @default(0.00) @db.Decimal(12, 2)
  epfEligibleEarnings     Decimal            @default(0.00) @db.Decimal(12, 2)
  epfEmployeeAmount       Decimal            @default(0.00) @db.Decimal(12, 2)
  epfEmployerAmount       Decimal            @default(0.00) @db.Decimal(12, 2)
  etfEmployerAmount       Decimal            @default(0.00) @db.Decimal(12, 2)
  apitTaxAmount           Decimal            @default(0.00) @db.Decimal(12, 2)
  loanDeductions          Decimal            @default(0.00) @db.Decimal(12, 2)
  otherDeductions         Decimal            @default(0.00) @db.Decimal(12, 2)
  totalDeductions         Decimal            @default(0.00) @db.Decimal(12, 2)
  netSalary               Decimal            @default(0.00) @db.Decimal(12, 2)
  employerTotalCost       Decimal            @default(0.00) @db.Decimal(12, 2)
  status                  String             @default("DRAFT") @db.VarChar(30)
  calculationSnapshotJson String?            @db.LongText
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  payrollRun              PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee                Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  earnings                PayrollEarning[]
  deductions              PayrollDeduction[]
  payslips                Payslip[]
  loanTransactions        LoanTransaction[]

  @@unique([payrollRunId, employeeId])
  @@map("payroll_run_employees")
}

model PayrollEarning {
  id                   String             @id @default(uuid())
  payrollRunEmployeeId String             @db.VarChar(36)
  name                 String             @db.VarChar(100)
  code                 String             @db.VarChar(50)
  amount               Decimal            @default(0.00) @db.Decimal(12, 2)
  isTaxable            Boolean            @default(true)
  isEpfEligible        Boolean            @default(false)

  payrollRunEmployee   PayrollRunEmployee @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Cascade)

  @@map("payroll_earnings")
}

model PayrollDeduction {
  id                   String             @id @default(uuid())
  payrollRunEmployeeId String             @db.VarChar(36)
  name                 String             @db.VarChar(100)
  code                 String             @db.VarChar(50)
  amount               Decimal            @default(0.00) @db.Decimal(12, 2)
  deductionType        String             @default("STATUTORY") @db.VarChar(30)

  payrollRunEmployee   PayrollRunEmployee @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Cascade)

  @@map("payroll_deductions")
}

model Payslip {
  id                   String             @id @default(uuid())
  organizationId       String             @db.VarChar(36)
  payrollRunEmployeeId String             @db.VarChar(36)
  employeeId           String             @db.VarChar(36)
  payslipNumber        String             @unique @db.VarChar(50)
  periodName           String             @db.VarChar(100)
  periodCode           String             @db.VarChar(20)
  paymentDate          String             @db.VarChar(10)
  grossPay             Decimal            @db.Decimal(12, 2)
  netPay               Decimal            @db.Decimal(12, 2)
  totalDeductions      Decimal            @db.Decimal(12, 2)
  pdfPath              String?            @db.VarChar(500)
  accessKey            String             @unique @db.VarChar(64)
  viewedAt             DateTime?
  downloadedAt         DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRunEmployee   PayrollRunEmployee @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Cascade)
  employee             Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payslips")
}

model EmployeeDocument {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  employeeId     String       @db.VarChar(36)
  title          String       @db.VarChar(255)
  documentType   String       @db.VarChar(50)
  fileUrl        String       @db.VarChar(500)
  fileName       String       @db.VarChar(255)
  fileSize       Int?
  mimeType       String?      @db.VarChar(100)
  expiryDate     String?      @db.VarChar(10)
  uploadedById   String?      @db.VarChar(36)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  name           String       @db.VarChar(150)
  date           String       @db.VarChar(10)
  holidayType    String       @default("PUBLIC") @db.VarChar(50)
  isRecurring    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@map("holidays")
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  userId         String?      @db.VarChar(36)
  employeeId     String?      @db.VarChar(36)
  title          String       @db.VarChar(255)
  message        String       @db.Text
  type           String       @default("SYSTEM") @db.VarChar(50)
  link           String?      @db.VarChar(500)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id               String       @id @default(uuid())
  organizationId   String       @db.VarChar(36)
  userId           String?      @db.VarChar(36)
  actorName        String       @db.VarChar(100)
  actorRole        String       @db.VarChar(50)
  action           String       @db.VarChar(50)
  module           String       @db.VarChar(50)
  recordId         String?      @db.VarChar(50)
  beforeValuesJson String?      @db.LongText
  afterValuesJson  String?      @db.LongText
  ipAddress        String?      @db.VarChar(50)
  userAgent        String?      @db.Text
  reason           String?      @db.Text
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SystemSetting {
  id             String       @id @default(uuid())
  organizationId String       @db.VarChar(36)
  key            String       @db.VarChar(100)
  value          String       @db.Text
  description    String?      @db.Text
  isPublic       Boolean      @default(false)
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("system_settings")
}
